    };
  }
}

/**
 * Busca inteligente (tenta referência, depois endereço, depois CEP)
 */
export async function smartSearch(query: string): Promise<ProperfySearchResult> {
  console.log('[Properfy] Iniciando busca inteligente para:', query);

  // Tentar como referência (ex: BG66206001)
  if (/^[A-Z]{2}\d+$/.test(query)) {
    const result = await searchByReference(query);
    if (result.success) return result;
  }

  // Tentar como CEP (ex: 30130100)
  if (/^\d{8}$/.test(query)) {
    const result = await searchByCep(query);
    if (result.success) return result;
  }

  // Tentar como endereço
  const result = await searchByAddress(query);
  return result;
}

/**
 * Aliases para compatibilidade com código existente
 */
export const searchPropertyByReference = searchByReference;
export const searchPropertyByAddress = searchByAddress;
export const searchPropertyByCEP = searchByCep;

/**
 * Obter rejeições de listagem (para compatibilidade)
 */
export async function getListingRejections(query: any): Promise<any> {
  console.log('[Properfy] getListingRejections chamado');
  return {
    success: true,
    rejections: [],
  };
}

export default {
  searchByReference,
  searchByAddress,
  searchByCep,
  smartSearch,
  searchPropertyByReference,
  searchPropertyByAddress,
  searchPropertyByCEP,
  getListingRejections,
};
